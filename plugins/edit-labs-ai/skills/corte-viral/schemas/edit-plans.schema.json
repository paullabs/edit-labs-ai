{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edit-plans.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "plans"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "clip_id",
          "output_slug",
          "primary_context",
          "timeline",
          "captions",
          "audio"
        ],
        "properties": {
          "clip_id": {
            "type": "string"
          },
          "output_slug": {
            "type": "string"
          },
          "primary_context": {
            "type": "string"
          },
          "timeline": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source_start",
                "source_end"
              ],
              "properties": {
                "source_start": {
                  "type": "number",
                  "minimum": 0
                },
                "source_end": {
                  "type": "number",
                  "minimum": 0
                },
                "crop_anchor_x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "zoom": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 2
                },
                "transition_in": {
                  "type": "string"
                },
                "preserve_pause": {
                  "type": "boolean"
                },
                "layout": {
                  "type": "string",
                  "enum": [
                    "cover",
                    "split"
                  ],
                  "description": "Sempre cover: crop unico 9:16 em quem fala. O vertical nunca divide a tela; split e aceito pelo schema, mas o render o trata como cover."
                },
                "framing_reason": {
                  "type": "string",
                  "description": "Por que este enquadramento neste subsegmento."
                }
              },
              "additionalProperties": true
            }
          },
          "captions": {
            "type": "object"
          },
          "audio": {
            "type": "object"
          },
          "cards": {
            "type": "array"
          },
          "optional_assets": {
            "type": "array"
          },
          "editor_notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
