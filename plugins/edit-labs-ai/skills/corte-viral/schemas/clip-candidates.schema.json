{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clip-candidates.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "clips"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "primary_context",
          "profile",
          "segments",
          "scores",
          "hard_fails"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "APPROVED",
              "REBUILD",
              "LONG_CLIP",
              "DUPLICATE",
              "WEAK",
              "REJECTED"
            ]
          },
          "primary_context": {
            "enum": [
              "dinheiro",
              "contradicao",
              "resposta-rapida",
              "historia",
              "revelacao",
              "opiniao",
              "humor",
              "autoridade",
              "transformacao",
              "tutorial",
              "long-clip",
              "outro"
            ]
          },
          "profile": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source_start",
                "source_end",
                "role",
                "order"
              ],
              "properties": {
                "source_start": {
                  "type": "number",
                  "minimum": 0
                },
                "source_end": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "role": {
                  "type": "string"
                },
                "order": {
                  "type": "integer",
                  "minimum": 1
                },
                "text": {
                  "type": "string"
                },
                "speaker": {
                  "type": "string"
                },
                "remove_from_body": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            }
          },
          "scores": {
            "type": "object",
            "properties": {
              "orientation": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "hook": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "proposition_clarity": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "first_value_speed": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "context_efficiency": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "stakes": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "curiosity_integrity": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "progression": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "payoff": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "closure": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "self_contained": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "shareability": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "visual_opportunity": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "novelty": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "editability": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "truthfulness": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              }
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "events": {
            "type": "object",
            "properties": {
              "orientation_at": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "proposition_at": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "first_value_at": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "first_turn_at": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "payoff_at": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "closure_at": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            },
            "additionalProperties": true
          },
          "semantic_beats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "at",
                "type",
                "description"
              ],
              "properties": {
                "at": {
                  "type": "number",
                  "minimum": 0
                },
                "type": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "hard_fails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "estimated_final_duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "editor_notes": {
            "type": "string"
          },
          "why_it_can_work": {
            "type": "string"
          },
          "truthfulness_notes": {
            "type": "string"
          },
          "source_quote": {
            "type": "string"
          },
          "reconstructed_transcript": {
            "type": "string"
          },
          "rebuild_attempt": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
